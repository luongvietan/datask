# ============================================================
# Datask — Environment Variables
# Copy to .env and fill in values. NEVER commit .env to git.
# ============================================================

# Application
APP_ENV=development                        # development | staging | production
APP_SECRET_KEY=change-me-to-random-32-chars
BASE_URL=https://datask.run                # Frontend base URL (used in emails, Stripe redirects)

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://datask:datask@localhost:5432/datask

# Redis (job queue + rate limiting)
REDIS_URL=redis://localhost:6380/0

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PAYG_ID=price_...

# OpenAI (Layer 3 — Natural Language Extraction)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Proxy (Brightdata ISP for anti-bot at scale)
BRIGHTDATA_PROXY_URL=http://user:pass@proxy.brightdata.com:PORT

# Rate limits (optional overrides)
FREE_TIER_MONTHLY_QUOTA=500
FREE_TIER_CONCURRENT=2
FREE_TIER_BURST_PER_MINUTE=10

# Worker
WORKER_CONCURRENCY=4
JOB_TIMEOUT_SECONDS=60

# Sentry (optional error tracking)
SENTRY_DSN=

# NextAuth (dashboard OAuth)
# NOTE: Next.js reads apps/web/.env.local — copy these vars there too.
NEXTAUTH_SECRET=change-me-to-random-32-chars
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_ID=
GITHUB_SECRET=

# Resend (email alerts, optional)
RESEND_API_KEY=

# Internal API URL (từ Next.js server component → FastAPI)
DATASK_API_URL=http://localhost:8000
